    set def [resolveDef $type]
    if {[dict get $def kind] eq "choice"} {
        return [choiceMatches $def $tlv]
    }
    lassign [typeUniversalTag $type] cls tag constructed
    return [expr {[dict get $tlv class] eq $cls && [dict get $tlv tag] == $tag}]
}

